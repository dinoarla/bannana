# ─── DATABASE ────────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/bannana_db"
# Production (Hostinger):
# DATABASE_URL="mysql://u164655286_dinobannana:PASSWORD@localhost:3306/u164655286_bannana"

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
CSRF_SECRET="generate-with-openssl-rand-base64-32"

# Local dev:
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production:
# NEXTAUTH_URL="https://bannana.id"
# NEXT_PUBLIC_APP_URL="https://bannana.id"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="bannana.id"

# ─── OAUTH (optional) ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── EMAIL (optional) ─────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="halo@bannana.id"

# ─── STORAGE (optional) ───────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="bannana-uploads"
R2_PUBLIC_URL="https://cdn.bannana.id"

# ─── REDIS (optional) ─────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
